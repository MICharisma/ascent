<% scope = "rizz_auth.creations.new" %>
<%= render layout: "devise/shared/card", locals: { title: t(:title, scope: scope), description: t(:description, scope: scope) } do %>
  <% if @signed_in_voter %>
    <p class="auth-hint" role="status"><%= t(:signed_in_notice, scope: scope, account: @signed_in_voter.handle || RizzSignIn.mask_email(@signed_in_voter.email)) %></p>
  <% end %>
  <% if google_proof_enabled? %>
    <% content_for :head do %>
      <%= tag.link rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Google+Sans:wght@500;600&display=swap" %>
    <% end %>
    <div class="auth-google-callout">
      <% if @handoff.google_uid.present? %>
        <p class="auth-hint" role="status"><%= t(:google_linked, scope: scope) %></p>
      <% else %>
        <p class="auth-google-callout-title"><%= t(:google_summary, scope: scope) %></p>
        <p class="auth-hint"><%= t(:google_hint, scope: scope, email: RizzSignIn.mask_email(@handoff.email)) %></p>
        <%= button_to "/auth/rizz/claim/google", method: :post, class: "auth-google google-sign-in auth-google--prominent", form: { data: { turbo: false } } do %>
          <%= image_tag "google-g.png", width: 22, height: 22, alt: "", aria: { hidden: true } %>
          <span><%= t(:google_button, scope: scope) %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <%= render "devise/shared/error_messages", resource: @voter %>
  <%= form_with model: @voter, scope: :voter, url: rizz_create_path, class: "auth-form", data: { turbo: false } do |form| %>
    <%= auth_field form, :email, type: :email, value: @handoff.email, readonly: true, hint: t(:email_hint, scope: scope) %>
    <div class="auth-name-fields">
      <%= auth_field form, :first_name, label: t(:first_name, scope: scope), autocomplete: "given-name", required: true %>
      <%= auth_field form, :last_name, label: t(:last_name, scope: scope), autocomplete: "family-name", required: true %>
    </div>
    <%= auth_field form, :username, type: :text, label: t(:handle, scope: scope), autocomplete: "username", required: true, minlength: 3, maxlength: 24, pattern: "[A-Za-z0-9_]{3,24}", hint: t(:handle_hint, scope: scope) %>
    <% if @suggested_username_taken %>
      <p class="auth-hint" role="status"><%= t(:handle_taken, scope: scope, handle: @voter.username) %></p>
    <% end %>
    <%= auth_field form, :display_name, type: :text, label: t(:display_name, scope: scope), autocomplete: "nickname", required: true, maxlength: 60 %>
    <details class="auth-field" <%= "open" if @voter.errors[:password].any? || @voter.errors[:password_confirmation].any? %>>
      <summary><%= t(:password_summary, scope: scope) %></summary>
      <%= auth_field form, :password, type: :password, autocomplete: "new-password", required: false, hint: t(:password_hint, scope: scope, minimum: minimum_password_length) %>
      <%= auth_field form, :password_confirmation, type: :password, label: t(:password_confirmation, scope: scope), autocomplete: "new-password", required: false %>
    </details>
    <%= form.submit t(:submit, scope: scope), class: "auth-submit" %>
  <% end %>
  <div class="auth-links">
    <%= button_to t(:cancel, scope: scope), rizz_create_cancel_path, method: :post, class: "auth-cancel" %>
  </div>
<% end %>
