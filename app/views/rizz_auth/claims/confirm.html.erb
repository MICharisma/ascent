<%= render layout: "devise/shared/card", locals: { title: "Connect to Rizz", description: "Check both sides before you connect." } do %>
  <dl class="auth-form">
    <div class="auth-field">
      <dt>Ascent account</dt>
      <dd><%= [ @voter.handle, masked_email(@voter.email), @voter.name.presence ].compact_blank.join(" · ") %></dd>
    </div>
    <div class="auth-field">
      <dt>Requested by Rizz</dt>
      <dd><%= @handoff.speaker_label %></dd>
    </div>
  </dl>
  <p class="auth-hint">Connecting lets <%= @handoff.speaker_label %> sign you in to this Ascent account. You can still sign in here with your own password.</p>
  <div class="auth-links">
    <%= button_to "Connect this account", rizz_claim_confirm_path, method: :post, class: "auth-submit", form: { data: { turbo: false } } %>
    <%= button_to "Cancel", rizz_claim_cancel_path, method: :post, class: "auth-google" %>
  </div>
<% end %>
